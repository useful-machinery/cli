{
  "schemaVersion": 1,
  "providers": [
    {
      "provider": "github",
      "environment": {
        "token": "GH_TOKEN",
        "tokenFile": "GH_TOKEN_FILE"
      }
    },
    {
      "provider": "gitlab.com",
      "environment": {
        "token": "GITLAB_TOKEN",
        "tokenFile": "GITLAB_TOKEN_FILE"
      }
    },
    {
      "provider": "linear",
      "environment": {
        "token": "USEFUL_LINEAR_ACCESS_TOKEN",
        "tokenFile": "USEFUL_LINEAR_ACCESS_TOKEN_FILE"
      }
    },
    {
      "provider": "mergify",
      "environment": {
        "token": "MERGIFY_TOKEN",
        "tokenFile": "MERGIFY_TOKEN_FILE"
      }
    },
    {
      "provider": "buildkite",
      "environment": {
        "token": "BUILDKITE_API_TOKEN",
        "tokenFile": "BUILDKITE_API_TOKEN_FILE"
      }
    },
    {
      "provider": "cloudflare",
      "environment": {
        "token": "CLOUDFLARE_API_TOKEN",
        "tokenFile": "CLOUDFLARE_API_TOKEN_FILE"
      }
    }
  ]
}
