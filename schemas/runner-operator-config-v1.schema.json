{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.usefulmachinery.com/schemas/runner-operator-config-v1.schema.json",
  "title": "Useful Machinery Runner Operator Configuration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deploymentMode", "runnerStatePath", "controlSocketPath", "workRoot"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deploymentMode": { "enum": ["production", "development"] },
    "runnerStatePath": { "type": "string", "pattern": "^/" },
    "controlSocketPath": { "type": "string", "pattern": "^/" },
    "workRoot": { "type": "string", "pattern": "^/" },
    "minimumFreeDiskBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "keptRuns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximumAgeDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 },
        "maximumTotalBytes": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "buildCaches": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "maximumBytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^/", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
          "maximumBytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
